rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // UID du compte admin unique (EDB 5 et 8).
    function isAdmin() {
      return request.auth != null && request.auth.uid == '68BS0N4ngd0yVPz0YQ7n3cll20zG';
    }

    function isUnder5Mb() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isUnder5Mb();
    }
  }
}
