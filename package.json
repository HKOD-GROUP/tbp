{
  "name": "tbp",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:tbp": "node dist/tbp/server/server.mjs",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\"",
    "check": "npm run lint && npm run build && npm run test -- --watch=false --browsers=ChromeHeadless",
    "emulators": "firebase emulators:start --import=./emulator-data --export-on-exit",
    "test:rules": "firebase emulators:exec --only firestore,storage \"node --test tests/firestore.rules.test.mjs tests/storage.rules.test.mjs\"",
    "seed": "node scripts/seed-emulator.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/fire": "^18.0.1",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/platform-server": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@angular/ssr": "^18.2.21",
    "express": "^4.18.2",
    "firebase": "^10.14.1",
    "ngx-quill": "^26.0.10",
    "quill": "^2.0.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.21",
    "@angular/cli": "^18.2.21",
    "@angular/compiler-cli": "^18.2.0",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "angular-eslint": "18.4.3",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^10.1.8",
    "firebase-tools": "^13.35.1",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.9.9",
    "typescript": "~5.5.2",
    "typescript-eslint": "8.16.0"
  }
}
